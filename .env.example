NEXT_PUBLIC_SITE_URL=http://localhost:4173

# Railway/PostgreSQL. Server-only. Do not expose this in the browser.
DATABASE_URL=postgresql://postgres:password@host.railway.internal:5432/railway
# Optional aliases also accepted by the app:
# POSTGRES_URL=postgresql://postgres:password@host:5432/postgres
# POSTGRES_PRISMA_URL=postgresql://postgres:password@host:5432/postgres
# POSTGRES_URL_NON_POOLING=postgresql://postgres:password@host:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:password@host:5432/postgres
POSTGRES_SSL=true

# Optional one-time admin bootstrap.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Ubuntu Academy Admin

# Billing integration, added here so production envs are complete.
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
