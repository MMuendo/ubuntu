# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Gemini API (for AI Chat Widget)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Database
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend Email Service
RESEND_API_KEY=your_resend_api_key

# Paystack Payment Gateway
# Get your keys from: https://dashboard.paystack.com/#/settings/developers
# Format: pk_test_xxx... (test) or pk_live_xxx... (production)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Format: sk_test_xxx... (test) or sk_live_xxx... (production)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# M-Pesa Daraja API (for later - Option C)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_PASSKEY=your_mpesa_passkey
MPESA_SHORTCODE=your_mpesa_shortcode
# Options: sandbox or production
MPESA_ENVIRONMENT=sandbox

# Stripe (for later - Option C)
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Application URLs
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000/api

# RAG System Backend (Optional - for enhanced course support)
RAG_API_URL=http://localhost:8000
ENABLE_RAG=false
